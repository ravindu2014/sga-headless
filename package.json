{
  "name": "sga-headless",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@swc/helpers": "0.5.24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "studio:dev": "npm run dev --prefix studio",
    "studio:build": "npm run build --prefix studio",
    "deploy:pages": "npm run build && npm run pages:deploy",
    "pages:deploy": "node scripts/cf-pages-deploy.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.17.0",
    "next": "^15.5.6",
    "next-intl": "^4.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.47.0"
  }
}
